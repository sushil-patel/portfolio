---
import Badge from './Badge.astro';

export interface Props {
  role: string;
  company: string;
  period: string;
  location: string;
  leadership?: string;
  highlights: string[];
  skills: string[];
}

const { role, company, period, location, leadership, highlights, skills } = Astro.props;
---

<div class="relative pl-6 sm:pl-8 border-l-2 border-slate-200 dark:border-slate-800 py-2">
  <!-- Timeline indicator dot -->
  <div class="absolute -left-[9px] top-3 h-4 w-4 rounded-full border-2 border-indigo-600 bg-white dark:bg-slate-950 shadow-xs"></div>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
    <div>
      <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 tracking-tight">{role}</h3>
      <div class="flex items-center gap-2 text-sm font-medium text-indigo-700 dark:text-indigo-400">
        <span>{company}</span>
        <span class="text-slate-300 dark:text-slate-700">·</span>
        <span class="text-slate-500 dark:text-slate-400 font-normal">{location}</span>
      </div>
    </div>
    <span class="font-mono text-xs text-slate-500 dark:text-slate-400 font-medium self-start sm:self-auto bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-md">
      {period}
    </span>
  </div>

  {leadership && (
    <div class="mt-3 rounded-lg border border-indigo-200 dark:border-indigo-800/60 bg-indigo-50/60 dark:bg-indigo-950/30 p-3 text-xs text-indigo-900 dark:text-indigo-200 leading-relaxed font-medium">
      <span class="font-bold text-indigo-950 dark:text-indigo-100">Leadership Scope: </span>
      {leadership}
    </div>
  )}

  <ul class="mt-4 space-y-2.5 text-sm text-slate-700 dark:text-slate-300 leading-relaxed list-disc list-outside ml-4">
    {highlights.map((point) => (
      <li>{point}</li>
    ))}
  </ul>

  <div class="mt-5 flex flex-wrap gap-1.5 pt-3 border-t border-slate-100 dark:border-slate-800">
    {skills.map((skill) => (
      <Badge text={skill} variant="subtle" size="sm" />
    ))}
  </div>
</div>
