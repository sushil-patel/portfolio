---
export interface Props {
  value: string;
  label: string;
  detail?: string;
}

const { value, label, detail } = Astro.props;
---

<div class="rounded-xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs transition hover:border-slate-300 dark:hover:border-slate-700 hover:shadow-sm">
  <div class="font-mono text-2xl font-bold tracking-tight sm:text-3xl text-indigo-600 dark:text-indigo-400">
    {value}
  </div>
  <div class="mt-1 font-semibold text-sm text-slate-800 dark:text-slate-200 tracking-tight">
    {label}
  </div>
  {detail && <div class="mt-1 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{detail}</div>}
</div>
