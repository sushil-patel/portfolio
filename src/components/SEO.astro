---
import { siteConfig } from '../config/site';
import { getAbsoluteUrl, getRelativePath } from '../utils/url';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  canonicalUrl?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/images/og-image.png',
  article,
  jsonLd,
  canonicalUrl = getAbsoluteUrl(Astro.url.pathname),
} = Astro.props;

const pageTitle = title.includes(siteConfig.name) ? title : `${title} | ${siteConfig.name}`;
const absoluteImageUrl = getAbsoluteUrl(image);

// Base JSON-LD schemas
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteConfig.siteUrl}#person`,
  name: siteConfig.name,
  jobTitle: siteConfig.role,
  worksFor: {
    '@type': 'Organization',
    name: siteConfig.currentCompany,
    url: siteConfig.currentCompanyUrl,
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: siteConfig.education.institution,
  },
  knowsAbout: [
    'Java',
    'Spring Boot',
    'Apache Kafka',
    'IBM MQ',
    'Redis',
    'Microservices',
    'REST APIs',
    'JPA / Hibernate',
    'SQL Performance Tuning',
    'High-Throughput Batch Processing',
  ],
  email: siteConfig.email,
  url: siteConfig.siteUrl,
  sameAs: [siteConfig.social.github, siteConfig.social.linkedin],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteConfig.siteUrl}#website`,
  url: siteConfig.siteUrl,
  name: `${siteConfig.name} - Portfolio & Technical Engineering`,
  description: siteConfig.description,
  author: {
    '@id': `${siteConfig.siteUrl}#person`,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteConfig.siteUrl,
    },
  ],
};

const defaultSchemas: any[] = [personSchema, websiteSchema, breadcrumbSchema];
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    defaultSchemas.push(...jsonLd);
  } else {
    defaultSchemas.push(jsonLd);
  }
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={getRelativePath('/favicon.svg')} />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content={siteConfig.name} />
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:site_name" content={`${siteConfig.name} Portfolio`} />

{article?.publishedTime && (
  <meta property="article:published_time" content={article.publishedTime} />
)}
{article?.modifiedTime && (
  <meta property="article:modified_time" content={article.modifiedTime} />
)}
{article?.tags?.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={absoluteImageUrl} />

<!-- Structured Data (JSON-LD) for SEO and Generative Engine Optimization (GEO) -->
<script type="application/ld+json" set:html={JSON.stringify(defaultSchemas)} />
