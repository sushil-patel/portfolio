---
import { siteConfig } from '../config/site';
import { getRelativePath } from '../utils/url';
---

<footer class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/50 text-slate-600 dark:text-slate-400 transition-colors">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Col 1: Bio & Positioning -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-slate-900 dark:text-slate-100 tracking-tight">{siteConfig.name}</span>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs text-slate-600 dark:text-slate-300 font-medium">Software Developer</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md leading-relaxed">
          {siteConfig.headline} Experienced in enterprise Java, Spring Boot, microservices architecture, and distributed event-driven systems.
        </p>
        <div class="pt-2 flex items-center gap-3 text-sm">
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white font-medium transition-colors"
          >
            GitHub
          </a>
          <span class="text-slate-300 dark:text-slate-700">·</span>
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white font-medium transition-colors"
          >
            LinkedIn
          </a>
          <span class="text-slate-300 dark:text-slate-700">·</span>
          <a
            href={`mailto:${siteConfig.email}`}
            class="text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white font-medium transition-colors"
          >
            Email
          </a>
          <span class="text-slate-300 dark:text-slate-700">·</span>
          <a
            href={getRelativePath(siteConfig.resumePath)}
            target="_blank"
            rel="noopener noreferrer"
            class="text-indigo-700 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 font-medium transition-colors"
          >
            Resume (PDF)
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 font-mono">Index</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={getRelativePath('/')} class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
              Home
            </a>
          </li>
          <li>
            <a href={getRelativePath('/projects')} class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
              Projects
            </a>
          </li>
          <li>
            <a href={getRelativePath('/experience')} class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
              Experience
            </a>
          </li>
          <li>
            <a href={getRelativePath('/writing')} class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
              Writing
            </a>
          </li>
          <li>
            <a href={getRelativePath('/about')} class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
              About
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Architecture & Links -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 font-mono">Links</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a href={getRelativePath('/resume')} class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
              Curriculum Vitae
            </a>
          </li>
          <li>
            <a href={getRelativePath('/contact')} class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
              Get in Touch
            </a>
          </li>
          <li class="pt-2">
            <a href={getRelativePath('/sitemap-index.xml')} class="text-xs text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 underline">
              sitemap.xml
            </a>
            <span class="text-slate-300 dark:text-slate-700 mx-1">·</span>
            <a href={getRelativePath('/robots.txt')} class="text-xs text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 underline">
              robots.txt
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 border-t border-slate-200/80 dark:border-slate-800/80 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>© {new Date().getFullYear()} {siteConfig.name}. Open for software engineering and development opportunities.</p>
    </div>
  </div>
</footer>
