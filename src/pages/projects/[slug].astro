---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Badge from '../../components/Badge.astro';
import MetricCard from '../../components/MetricCard.astro';
import { siteConfig } from '../../config/site';
import { getRelativePath } from '../../utils/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();

// Related writing articles if referenced
const allWriting = await getCollection('writing');
const relatedPosts = project.data.relatedWriting
  ? allWriting.filter((post) => project.data.relatedWriting?.includes(post.slug))
  : [];

// JSON-LD structured data for project
const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.data.title,
  description: project.data.description,
  author: {
    '@type': 'Person',
    name: siteConfig.name,
  },
  codeRepository: project.data.githubUrl || undefined,
};
---

<BaseLayout
  seo={{
    title: `${project.data.title} | Case Study`,
    description: project.data.description,
    jsonLd: projectJsonLd,
  }}
>
  <Breadcrumbs
    items={[
      { name: 'Projects', href: '/projects' },
      { name: project.data.title },
    ]}
  />

  <article class="max-w-4xl mx-auto">
    <!-- Header -->
    <header class="border-b border-slate-200 dark:border-slate-800 pb-8 mb-8">
      <div class="flex items-center gap-2 mb-3">
        <Badge text={project.data.category} variant="accent" size="sm" />
        <span class="text-slate-300 dark:text-slate-700">·</span>
        <span class="font-mono text-xs text-slate-500 dark:text-slate-400 font-medium">{project.data.date}</span>
      </div>

      <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl lg:text-5xl">
        {project.data.title}
      </h1>

      <p class="mt-4 text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
        {project.data.description}
      </p>

      <!-- Key Metadata Row -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 dark:border-slate-800 pt-4 text-xs">
        <div>
          <span class="text-slate-400 block font-mono">Role & Scope</span>
          <span class="font-semibold text-slate-800 dark:text-slate-200">{project.data.role}</span>
        </div>

        <div class="flex items-center gap-3">
          {project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3.5 py-1.5 font-semibold text-slate-800 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-800 transition"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>View Source on GitHub</span>
            </a>
          )}
          {project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3.5 py-1.5 font-semibold text-white shadow-xs hover:bg-indigo-700 transition"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span>Live Deployment</span>
            </a>
          )}
        </div>
      </div>

      <!-- Technologies Badges -->
      <div class="mt-4 flex flex-wrap gap-1.5">
        {project.data.technologies.map((t) => (
          <Badge text={t} variant="default" size="sm" />
        ))}
      </div>
    </header>

    <!-- Key Metrics Highlight Bar -->
    {project.data.metrics && project.data.metrics.length > 0 && (
      <div class="mb-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {project.data.metrics.map((m) => (
          <MetricCard value={m.value} label={m.label} />
        ))}
      </div>
    )}

    <!-- MDX Rendered Body with Dark Mode Prose -->
    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-20 prose-pre:border prose-pre:border-slate-800">
      <Content />
    </div>

    <!-- Related Technical Writing Links -->
    {relatedPosts.length > 0 && (
      <aside class="mt-12 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/50 p-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 font-mono">
          Related Technical Deep Dives
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Explore underlying architectural lessons and code samples written from this project:
        </p>
        <ul class="mt-4 space-y-3">
          {relatedPosts.map((post) => (
            <li class="flex items-center justify-between text-sm">
              <a
                href={getRelativePath(`/writing/${post.slug}`)}
                class="font-semibold text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
              >
                &rarr; {post.data.title}
              </a>
              <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">{post.data.readingTime}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <!-- Back to Projects link -->
    <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
      <a
        href={getRelativePath('/projects')}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-colors"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Back to Projects</span>
      </a>

      <a
        href={getRelativePath('/contact')}
        class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors"
      >
        Discuss this project &rarr;
      </a>
    </div>
  </article>
</BaseLayout>
