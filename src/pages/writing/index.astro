---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('writing');
const publishedArticles = allArticles
  .filter((a) => !a.data.draft)
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());
---

<BaseLayout
  seo={{
    title: 'Technical Writing & Architecture Notes',
    description: 'Practical software engineering articles on Spring Boot, JPA optimization, event-driven architectures with Kafka & IBM MQ, and database security.',
  }}
>
  <Breadcrumbs items={[{ name: 'Writing' }]} />

  <!-- Page Header -->
  <div class="max-w-3xl mb-10">
    <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-indigo-700 dark:text-indigo-400 font-semibold">
      <span>Engineering Log</span>
    </div>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
      Technical Writing &amp; Architecture Notes
    </h1>
    <p class="mt-3 text-base text-slate-600 dark:text-slate-400 leading-relaxed">
      Detailed explorations of software challenges, database profiling, distributed messaging design, and enterprise migrations.
    </p>
  </div>

  <!-- Articles List -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {publishedArticles.map((article) => (
      <ArticleCard
        title={article.data.title}
        slug={article.slug}
        description={article.data.description}
        publishedDate={article.data.publishedDate}
        tags={article.data.tags}
        readingTime={article.data.readingTime}
      />
    ))}
  </div>
</BaseLayout>
