---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Badge from '../../components/Badge.astro';
import { siteConfig } from '../../config/site';
import { getRelativePath, getAbsoluteUrl } from '../../utils/url';

export async function getStaticPaths() {
  const articles = await getCollection('writing');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'writing'>;
}

const { article } = Astro.props;
const { Content } = await article.render();

// Related Project lookup
const allProjects = await getCollection('projects');
const relatedProject = article.data.relatedProject
  ? allProjects.find((p) => p.slug === article.data.relatedProject)
  : null;

// JSON-LD Article schema
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishedDate,
  dateModified: article.data.updatedDate || article.data.publishedDate,
  author: {
    '@type': 'Person',
    name: siteConfig.name,
    url: siteConfig.siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: siteConfig.name,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': getAbsoluteUrl(`/writing/${article.slug}`),
  },
};
---

<BaseLayout
  seo={{
    title: article.data.title,
    description: article.data.description,
    article: {
      publishedTime: article.data.publishedDate,
      modifiedTime: article.data.updatedDate,
      tags: article.data.tags,
    },
    jsonLd: articleJsonLd,
  }}
>
  <Breadcrumbs
    items={[
      { name: 'Writing', href: '/writing' },
      { name: article.data.title },
    ]}
  />

  <article class="max-w-3xl mx-auto">
    <!-- Header -->
    <header class="border-b border-slate-200 dark:border-slate-800 pb-6 mb-8">
      <div class="flex items-center gap-3 text-xs font-mono text-slate-500 dark:text-slate-400 mb-3">
        <time datetime={article.data.publishedDate}>{article.data.publishedDate}</time>
        <span>·</span>
        <span>{article.data.readingTime}</span>
        <span>·</span>
        <span>By {siteConfig.name}</span>
      </div>

      <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
        {article.data.title}
      </h1>

      <p class="mt-4 text-lg text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
        {article.data.description}
      </p>

      <div class="mt-4 flex flex-wrap gap-1.5 pt-2">
        {article.data.tags.map((tag) => (
          <Badge text={tag} variant="subtle" size="sm" />
        ))}
      </div>
    </header>

    <!-- Related Project Banner (Contextual link between code & writing) -->
    {relatedProject && (
      <div class="mb-8 rounded-lg border border-indigo-200 dark:border-indigo-800/80 bg-indigo-50/70 dark:bg-indigo-950/40 p-4 text-xs text-indigo-950 dark:text-indigo-200 flex items-center justify-between gap-4">
        <div>
          <span class="font-bold">Implemented in Project: </span>
          <span>{relatedProject.data.title}</span>
        </div>
        <a
          href={getRelativePath(`/projects/${relatedProject.slug}`)}
          class="font-semibold text-indigo-700 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 underline whitespace-nowrap"
        >
          View Case Study &rarr;
        </a>
      </div>
    )}

    <!-- Article Content with Dark Mode Prose -->
    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-20">
      <Content />
    </div>

    <!-- Article Footer / Navigation -->
    <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-sm">
      <a
        href={getRelativePath('/writing')}
        class="inline-flex items-center gap-1.5 font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-colors"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Back to All Articles</span>
      </a>

      <a
        href={getRelativePath('/contact')}
        class="font-semibold text-indigo-700 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors"
      >
        Have a question or feedback? &rarr;
      </a>
    </div>
  </article>
</BaseLayout>
