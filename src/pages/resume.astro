---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Badge from '../components/Badge.astro';
import { siteConfig } from '../config/site';
import { getRelativePath } from '../utils/url';

const pdfUrl = getRelativePath(siteConfig.resumePath);
---

<BaseLayout
  seo={{
    title: 'Resume & Curriculum Vitae | Sushil Patel',
    description: 'Verified curriculum vitae of Sushil Patel, Software Developer and Module Lead at TCS with 3 years of enterprise software experience.',
  }}
>
  <Breadcrumbs items={[{ name: 'Resume' }]} />

  <div class="max-w-5xl mx-auto">
    <!-- Top Action Bar for Recruiters -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-xl border border-indigo-200 dark:border-indigo-800/80 bg-indigo-50/70 dark:bg-indigo-950/30 p-4 sm:p-5">
      <div>
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-indigo-500"></span>
          <span class="font-bold text-sm text-indigo-950 dark:text-indigo-100">Official Curriculum Vitae</span>
          <Badge text="PDF" variant="accent" size="sm" />
        </div>
        <p class="text-xs text-indigo-900 dark:text-indigo-200 mt-1">
          Review the full multi-page document below, open in a new tab, or download directly.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href={getRelativePath(siteConfig.resumePath)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-indigo-300 dark:border-indigo-700 bg-white dark:bg-slate-900 px-3.5 py-2 text-xs font-semibold text-slate-800 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-800 transition focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
          <svg class="h-3.5 w-3.5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>Open Fullscreen</span>
        </a>

        <a
          href={pdfUrl}
          download="SushilPatel.pdf"
          class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-indigo-700 transition focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download PDF</span>
        </a>

        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3.5 py-2 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition"
        >
          <svg class="h-4 w-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Print</span>
        </button>
      </div>
    </div>

    <!-- Desktop & Tablet: Embedded PDF Viewer -->
    <div class="hidden sm:block rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 shadow-sm overflow-hidden">
      <object
        data={`${pdfUrl}#toolbar=1&navpanes=0`}
        type="application/pdf"
        class="w-full h-[1100px] border-0"
      >
        <iframe
          src={`${pdfUrl}#toolbar=1&navpanes=0`}
          class="w-full h-[1100px] border-0"
          title="Sushil Patel — Curriculum Vitae"
        >
          <div class="p-8 text-center text-sm text-slate-600 dark:text-slate-400">
            <p>Your browser doesn't support inline PDF display.</p>
            <a
              href={pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-block font-semibold text-indigo-600 dark:text-indigo-400 underline"
            >
              Click here to view or download the PDF resume
            </a>
          </div>
        </iframe>
      </object>
    </div>

    <!-- Mobile Screen Optimization -->
    <div class="sm:hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 mb-4">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>

      <h2 class="text-lg font-bold text-slate-900 dark:text-white">Curriculum Vitae (PDF)</h2>
      <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
        For the best reading experience on mobile, tap below to view or download the high-resolution PDF.
      </p>

      <div class="mt-5 flex flex-col gap-2.5">
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-xs hover:bg-indigo-700 transition"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Open PDF Resume</span>
        </a>

        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3.5 py-2 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition"
        >
          <svg class="h-4 w-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Print</span>
        </button>
      </div>
    </div>

    <!-- Crawlable Verified Credentials & Summary (Preserves 100% SEO & Authenticity) -->
    <div class="mt-8 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-sm">
      <div class="border-b border-slate-100 dark:border-slate-800 pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h2 class="text-base font-bold text-slate-900 dark:text-white">
            Quick Reference &amp; Verified Credentials
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Key professional details and official verification links
          </p>
        </div>

        <div class="flex items-center gap-3 text-xs font-mono text-slate-600 dark:text-slate-400">
          <span>{siteConfig.location}</span>
          <span>·</span>
          <a href={`mailto:${siteConfig.email}`} class="text-indigo-600 dark:text-indigo-400 hover:underline">{siteConfig.email}</a>
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Education & Role -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 font-mono mb-3">
            Current Role &amp; Education
          </h3>
          <div class="space-y-3 text-xs sm:text-sm">
            <div>
              <span class="font-bold text-slate-900 dark:text-white">{siteConfig.currentRole}</span>
              <span class="text-slate-600 dark:text-slate-400 block">{siteConfig.currentCompany}</span>
            </div>
            <div>
              <span class="font-bold text-slate-900 dark:text-white">{siteConfig.education.institution}</span>
              <span class="text-slate-600 dark:text-slate-400 block">{siteConfig.education.degree} · {siteConfig.education.score}</span>
            </div>
          </div>
        </div>

        <!-- Verified Certifications & Achievements -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 font-mono mb-3">
            Certifications &amp; Achievements
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            <li>
              <a href="https://www.credly.com/badges/e4ada754-02de-4034-b39f-f14e4cfb744b/public_url" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-indigo-700 dark:text-indigo-400">
                AWS Certified Developer – Associate
              </a> (Amazon Web Services)
            </li>
            <li>
              <a href="https://drive.google.com/file/d/11i7DbeSJLYFWrWZQZjYd5j4-2Q9PKLGL/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-indigo-700 dark:text-indigo-400">
                1st Runner Up
              </a> – TCS AI Fridays Hackathon Mumbai Regional Finals
            </li>
            <li>
              <a href="https://drive.google.com/file/d/1Jez0qSIcG5J8J-3Zljt1l_Us44KgzOZA/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-indigo-700 dark:text-indigo-400">
                High Impact Team Award
              </a> – TCS
            </li>
            <li>
              <a href="https://drive.google.com/file/d/1npEbi9OugfGsAOussC5GophyES2B_Fp1/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-indigo-700 dark:text-indigo-400">
                Top 10%
              </a> – AI4ICPS Program, TCS x IIT Kharagpur
            </li>
            <li>
              <a href="https://drive.google.com/file/d/1BNBiEoSLWRjRj-MdM-4zeOQ2D_OM5lqE/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="hover:underline font-semibold text-indigo-700 dark:text-indigo-400">
                Special Initiative Award
              </a> – TCS
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
