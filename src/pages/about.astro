---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Badge from '../components/Badge.astro';
import { siteConfig } from '../config/site';
import { getRelativePath } from '../utils/url';
---

<BaseLayout
  seo={{
    title: 'About Sushil Patel | Software Developer',
    description: 'Background, engineering philosophy, and experience of Sushil Patel, Software Developer and Module Lead at TCS.',
  }}
>
  <Breadcrumbs items={[{ name: 'About' }]} />

  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="border-b border-slate-200 dark:border-slate-800 pb-8 mb-8">
      <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-indigo-700 dark:text-indigo-400 font-semibold">
        <span>Profile &amp; Approach</span>
      </div>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
        About Sushil Patel
      </h1>
      <p class="mt-3 text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
        Software Developer and Module Lead at Tata Consultancy Services (TCS), dedicated to high-availability systems, distributed backend services, and resilient architecture.
      </p>
    </div>

    <!-- Main Content -->
    <div class="space-y-10 text-slate-700 dark:text-slate-300 leading-relaxed">
      <!-- Summary section -->
      <section>
        <h2 class="text-xl font-bold text-slate-950 dark:text-white tracking-tight mb-3">
          Background
        </h2>
        <p>
          I have 3 years of enterprise software engineering experience building and maintaining critical applications. Currently, I serve as a <strong>Module Lead</strong> at <strong>Tata Consultancy Services (TCS) Limited</strong>, where I lead a module of 4 engineers driving application design, code reviews, and cross-functional delivery.
        </p>
        <p class="mt-3">
          My technical experience centers on enterprise backend engineering and systems programming (<strong>Java, Spring Boot, Apache Kafka, IBM MQ, Redis, SQL</strong>), developer automation tooling (<strong>Python, CI/CD pipelines</strong>), and reliable cloud architectures. I enjoy dissecting complex systems, optimizing queries and data pipelines, eliminating deployment friction, and building clean, maintainable software.
        </p>
      </section>

      <!-- Engineering Philosophy -->
      <section>
        <h2 class="text-xl font-bold text-slate-950 dark:text-white tracking-tight mb-3">
          Engineering Principles
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 p-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-1">1. Respect Abstractions &amp; Understand the SQL</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400">
              ORMs are powerful, but understanding the underlying queries is essential. I always profile SQL generation, examine execution plans, and eliminate N+1 queries using EntityGraph and DTO projections.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 p-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-1">2. Decouple via Events &amp; Queues</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400">
              Heavy tasks should never hold user requests hostage. Utilizing message streaming with Kafka or enterprise queues ensures asynchronous decoupling, fault tolerance, and replayable execution.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 p-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-1">3. Zero-Downtime Evolution</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400">
              Database schema updates and security credential upgrades must never interrupt active users. I rely on Flyway migrations and backward-compatible dual-check migration patterns.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 p-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-1">4. Maintainable Code &amp; Governance</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400">
              Quality software requires deliberate practice: SOLID design principles, SonarQube quality gates, comprehensive automated tests with JUnit &amp; Mockito, and collaborative code reviews.
            </p>
          </div>
        </div>
      </section>

      <!-- Education & Academics -->
      <section>
        <h2 class="text-xl font-bold text-slate-950 dark:text-white tracking-tight mb-3">
          Education
        </h2>
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <div>
              <h3 class="font-bold text-base text-slate-900 dark:text-slate-100">{siteConfig.education.institution}</h3>
              <p class="text-sm text-indigo-700 dark:text-indigo-400 font-medium">{siteConfig.education.degree}</p>
            </div>
            <div class="text-left sm:text-right">
              <span class="font-mono text-xs text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded">{siteConfig.education.period}</span>
              <p class="text-xs font-semibold text-slate-700 dark:text-slate-300 mt-1">{siteConfig.education.score}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Certifications & Achievements with Clickable Links -->
      <section>
        <h2 class="text-xl font-bold text-slate-950 dark:text-white tracking-tight mb-3">
          Certifications &amp; Achievements
        </h2>
        <div class="space-y-3">
          {siteConfig.certifications.map((cert) => (
            <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 flex items-center justify-between">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="font-semibold text-sm text-slate-900 dark:text-slate-100">{cert.title}</h3>
                  {cert.url && (
                    <a
                      href={cert.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 inline-flex items-center"
                      title="Verify Certificate"
                    >
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">{cert.issuer} · {cert.description}</p>
              </div>
              <Badge text={cert.badge} variant="accent" size="sm" />
            </div>
          ))}

          {siteConfig.achievements.map((ach) => (
            <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <h3 class="font-semibold text-sm text-slate-900 dark:text-slate-100">{ach.title}</h3>
                  {ach.url && (
                    <a
                      href={ach.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 inline-flex items-center"
                      title="Learn More"
                    >
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>
                <span class="font-mono text-[11px] text-slate-400">{ach.organization}</span>
              </div>
              <p class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{ach.description}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- Quick Navigation Footer -->
    <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
      <a
        href={getRelativePath('/projects')}
        class="text-sm font-semibold text-slate-800 dark:text-slate-200 hover:text-indigo-600 dark:hover:text-indigo-400 transition"
      >
        &larr; View Featured Projects
      </a>
      <a
        href={getRelativePath('/experience')}
        class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition"
      >
        View Professional Experience &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
