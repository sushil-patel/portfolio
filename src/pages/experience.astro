---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import MetricCard from '../components/MetricCard.astro';
import Badge from '../components/Badge.astro';
import { siteConfig } from '../config/site';
import { getRelativePath } from '../utils/url';
---

<BaseLayout
  seo={{
    title: 'Professional Experience & Work History',
    description: 'Detailed work history, technical contributions, and enterprise module leadership of Sushil Patel at Tata Consultancy Services (TCS).',
  }}
>
  <Breadcrumbs items={[{ name: 'Experience' }]} />

  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="border-b border-slate-200 dark:border-slate-800 pb-8 mb-8">
      <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-indigo-700 dark:text-indigo-400 font-semibold">
        <span>Career Track</span>
      </div>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
        Work Experience &amp; Leadership
      </h1>
      <p class="mt-3 text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
        3 years of enterprise software engineering focused on mission-critical applications, backend workflows, asynchronous messaging, and operational stability.
      </p>

      <!-- Key Impact Metrics Bar -->
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <MetricCard value="50% Cut" label="Batch Runtime" detail="Optimized parallel batch jobs" />
        <MetricCard value="800K+" label="Throughput" detail="Records in < 20 min via IBM MQ" />
        <MetricCard value="-30%" label="Server Load" detail="Redis-based rate limiting" />
        <MetricCard value="+25%" label="Stability" detail="Preventive fixes & RCA resolution" />
      </div>
    </div>

    <!-- Timeline Detail -->
    <div class="space-y-12">
      <ExperienceCard
        role="Software Developer — Java Developer — Module Lead"
        company="Tata Consultancy Services (TCS) Limited"
        period="Oct 2023 – Present"
        location="India"
        leadership="Leading a dedicated module of 4 engineers. Responsible for end-to-end design reviews, architectural alignment, sprint execution, code review enforcement, junior developer mentorship, and direct collaboration with QA and client stakeholders."
        highlights={[
          "Reduced batch processing duration by 50% by redesigning sequential Java batch workflows into parallel executions with Redis-based caching and task partitioning for high-volume enterprise workloads.",
          "Contributed to the architecture and implementation of high-throughput, event-driven backend services capable of ingesting 800K+ records in under 20 minutes using file-splitting, IBM MQ message queues, fault-tolerant retry policies, and bulk SQL operations.",
          "Engineered distributed Redis-based rate limiting and JWT authentication filters in Spring Boot, reducing peak-period server load by 30% and eliminating unauthorized endpoint probing.",
          "Conceived and developed an automated Artifact Comparison & Deployment Validation Tool that eliminated a 2.5-hour manual Beyond Compare bottleneck during staging-to-production cutovers, reducing verification time to under 3 minutes; the utility was officially acquired by the project module and recognized with a Special Initiative Award.",
          "Automated inbound financial file processing via scheduled Spring Boot tasks and SFTP, implementing SHA-256 integrity validation, automated alerting, and poison-pill recovery.",
          "Executed backward-compatible password storage migration from legacy MD5 to BCrypt, implementing on-login dynamic rehashing that upgraded credentials with zero user downtime.",
          "Troubleshot high-priority production incidents through deep log analysis and root-cause analysis (RCA), introducing architectural guards that increased operational stability by roughly 25%.",
          "Enforced strict engineering standards across the module following SOLID principles, SonarQube quality gates, automated testing with JUnit and Mockito, and secure coding guidelines."
        ]}
        skills={[
          "Java 8/17/21",
          "Spring Boot",
          "Spring MVC",
          "Spring Security",
          "Spring Data JPA",
          "Hibernate",
          "REST APIs",
          "Microservices",
          "IBM MQ",
          "Apache Kafka",
          "Redis",
          "Oracle SQL",
          "MySQL",
          "Jenkins CI/CD",
          "SonarQube",
          "Maven",
          "GitLab",
          "JUnit 5",
          "Mockito"
        ]}
      />
    </div>

    <!-- Enterprise Awards Won During Tenure with Clickable Links -->
    <div class="mt-12 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/50 p-6">
      <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 tracking-tight mb-4">
        Enterprise Honors &amp; Awards at TCS
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {siteConfig.achievements.map((item) => (
          <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
            <span class="font-mono text-[11px] text-indigo-700 dark:text-indigo-400 font-semibold block">{item.organization}</span>
            <div class="flex items-center gap-1.5 mt-1">
              <h3 class="font-bold text-sm text-slate-900 dark:text-slate-100">{item.title}</h3>
              {item.url && (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300"
                  title="Learn More"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}
            </div>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Actions -->
    <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
      <a
        href={getRelativePath(siteConfig.resumePath)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition"
      >
        <svg class="h-4 w-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download Official Resume (PDF)</span>
      </a>

      <a
        href={getRelativePath('/contact')}
        class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition"
      >
        Discuss opportunities &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
